# --- App ---
APP_ENV=local
APP_NAME=Commerce Intelligence
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database ---
# Used directly by the app (pydantic-settings) when running outside Docker.
# docker-compose overrides this to point at the "db" service instead of localhost.
DATABASE_URL=postgresql+psycopg://ai_commerce:ai_commerce@localhost:5432/ai_commerce
# Used by docker-compose to provision the postgres container
POSTGRES_USER=ai_commerce
POSTGRES_PASSWORD=ai_commerce
POSTGRES_DB=ai_commerce

# --- docker-compose host port overrides ---
# Change these if the default port is already taken on your machine (e.g. a
# native/other Postgres already listening on 5432).
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000
UI_HOST_PORT=8501

# Number of uvicorn worker processes in the api container. 1 is safe for the
# MVP's synchronous, single-container deployment; raise it once request volume
# warrants more than one process (see docker/api.Dockerfile).
WEB_CONCURRENCY=1

# --- AI provider ---
# mock | anthropic | openai | auto
#   mock     - always mocked, no key needed (default)
#   anthropic/openai - forces that provider, falling back to mock if its key is empty
#   auto     - tries Anthropic first, then OpenAI, using whichever key is set
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Data providers (all default to "mock" so the MVP runs with zero external keys) ---
SEARCH_PROVIDER=mock
SUPPLIER_PROVIDER=mock
MARKETPLACE_PROVIDER=mock

# --- Profitability defaults (used when a request doesn't override assumptions) ---
DEFAULT_MARKETPLACE_FEE_PCT=15
DEFAULT_PAYMENT_FEE_PCT=3
DEFAULT_CURRENCY=USD

# --- UI ---
API_BASE_URL=http://localhost:8000/api/v1
